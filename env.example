# Copy to .env and fill in your values. Never commit .env or a service-account key.

# Realtime Database URL, e.g. https://<project>-default-rtdb.firebaseio.com
FIREBASE_DB_URL=

# Service-account JSON: either a file path...
FIREBASE_CRED_PATH=firebase-admin-key.json
# ...or the full JSON content (prefer this for secret managers / hosting env vars)
# FIREBASE_CRED_JSON=

# Password that grants host controls. Required: when it is empty, nobody can
# become the host (the server fails closed).
HOST_PASSWORD=

# Local dev server only (app.py). Defaults: 127.0.0.1, port 3000, debugger off.
# HOST=0.0.0.0
# PORT=3000
# FLASK_DEBUG=1
