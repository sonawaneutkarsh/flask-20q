# Copy to .env and fill in your values. Never commit .env or a service-account key.

# Realtime Database URL, e.g. https://<project>-default-rtdb.firebaseio.com
FIREBASE_DB_URL=

# Service-account JSON: either a file path...
FIREBASE_CRED_PATH=firebase-admin-key.json
# ...or the full JSON content (prefer this for secret managers / the Freebuff Keys UI)
# FIREBASE_CRED_JSON=

# Password that grants host controls (new game, advance, clear chat/history).
# Defaults to "host123" if unset — set your own value before going public.
HOST_PASSWORD=
